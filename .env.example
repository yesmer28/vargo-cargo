# PostgreSQL
DB_USER=postgres
DB_PASSWORD=vargo123
DB_NAME=vargo_cargo
# Puerto en el host (Django fuera de Docker)
DB_PORT=5433
# Datos: volumen Docker externo `vargo_cargo_postgres_data` (ver docker-compose.yml)
# PRODUCCIÓN: NUNCA docker compose down -v | docker volume rm | recreate
# DB_SYNC: solo true la primera vez sin datos; luego siempre false
DB_SYNC=false

# Backend
JWT_SECRET=change-me-to-a-long-random-secret
# Orígenes del frontend (separados por coma, sin espacios)
CORS_ORIGIN=https://vargocargo.com,https://www.vargocargo.com

# Frontend: URL del backend para el proxy interno (/api → backend).
# En Docker Compose use el nombre del servicio; fuera de Docker, la URL pública del API.
API_URL=http://backend:5000
